# Stripe secret key (Dashboard > Developers > API keys). Use sk_test_... while testing.
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint pointing at <PUBLIC_URL>/webhook
STRIPE_WEBHOOK_SECRET=
# Public URL where this server is reachable
PUBLIC_URL=http://localhost:4242
# Web origins allowed as checkout return URLs (comma-separated)
ALLOWED_WEB_ORIGINS=http://localhost:8081
# Countries you ship to (comma-separated ISO codes)
SHIPPING_COUNTRIES=US

# Email for portrait commission requests (e.g. Gmail: smtp.gmail.com / 465 / your address / an App Password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
COMMISSION_EMAIL_TO=ncavey8@gmail.com
